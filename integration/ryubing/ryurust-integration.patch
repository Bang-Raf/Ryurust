+                if (Unsafe.ReadUnaligned<uint>(ref MemoryMarshal.GetReference(current[off..])) !=
+                    Unsafe.ReadUnaligned<uint>(ref MemoryMarshal.GetReference(shadow[off..])))
+                {
+                    SetDirty(off);
+                }
+            }
+        }
+
+        ~StateUpdateTracker()
+        {
+            if (_nativeTracker != IntPtr.Zero)
+            {
+                NativeMaxwellState.DestroyTracker(_nativeTracker);
+            }
+        }
     }
 }
