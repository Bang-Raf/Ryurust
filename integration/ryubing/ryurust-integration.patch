new file mode 100644
index 0000000000000000000000000000000000000000..0d0d98127c094eab1d0850b61b7358bc361d6d6e
--- /dev/null
+++ b/src/Ryujinx.Common/Diagnostics/GameplayAnomalyTracker.cs
@@ -0,0 +1,138 @@
+using Ryujinx.Common.Logging;
+using System;
+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.Text;
+using System.Threading;
+
+namespace Ryujinx.Common.Diagnostics
+{
+    /// <summary>
+    /// Categorization of runtime emulation anomalies and non-fatal errors caught during gameplay.
+    /// </summary>
+    public enum AnomalyCategory
+    {
+        GpuSyncpointTimeout,
+        ShaderDivergentBarrier,
+        ProfileOverwriteAttempt,
+        UpdaterNetworkFailure,
+        JitCacheExhaustion,
+        UnhandledServiceStub,
+        FramePacingStall,
+        EmulationExceptionCaught,
+    }
+
+    /// <summary>
+    /// Diagnostic record of an individual caught runtime anomaly.
+    /// </summary>
+    public readonly struct AnomalyRecord
+    {
+        public readonly AnomalyCategory Category;
+        public readonly string Source;
+        public readonly string Detail;
+        public readonly long LatencyUs;
+        public readonly DateTime Timestamp;
+
+        public AnomalyRecord(AnomalyCategory category, string source, string detail, long latencyUs)
+        {
+            Category = category;
+            Source = source ?? string.Empty;
+            Detail = detail ?? string.Empty;
+            LatencyUs = latencyUs;
+            Timestamp = DateTime.UtcNow;
+        }
+
+        public override string ToString()
+        {
+            return $"[{Timestamp:HH:mm:ss.fff}] [{Category}] ({Source}) {Detail}" + (LatencyUs > 0 ? $" (Latency: {LatencyUs}µs)" : string.Empty);
+        }
+    }
+
+    /// <summary>
+    /// Thread-safe Gameplay Anomaly Tracker & Debug Telemetry Interceptor for Ryubing.
+    /// Captures, logs, and aggregates anomalies during emulation sessions.
+    /// </summary>
+    public static class GameplayAnomalyTracker
+    {
+        private const int MaxRecentRecords = 256;
+        private static readonly ConcurrentQueue<AnomalyRecord> _recentRecords = new();
+        private static readonly long[] _categoryCounters = new long[Enum.GetValues<AnomalyCategory>().Length];
+        private static long _totalAnomalies;
+        private static readonly Stopwatch _uptime = Stopwatch.StartNew();
+
+        /// <summary>
+        /// Records an intercepted runtime anomaly or non-fatal debugging error.
+        /// </summary>
+        public static void RecordAnomaly(AnomalyCategory category, string source, string detail, long latencyUs = 0)
+        {
+            Interlocked.Increment(ref _totalAnomalies);
+            Interlocked.Increment(ref _categoryCounters[(int)category]);
+
+            var record = new AnomalyRecord(category, source, detail, latencyUs);
+            _recentRecords.Enqueue(record);
+
+            while (_recentRecords.Count > MaxRecentRecords && _recentRecords.TryDequeue(out _))
+            {
+                // Discard older entries in bounded ring buffer
+            }
+
+            Logger.Debug?.Print(LogClass.Application, $"[GameplayAnomaly:{category}] ({source}) {detail}");
+        }
+
+        /// <summary>
+        /// Gets the total count of anomalies caught for a specific category.
+        /// </summary>
+        public static long GetCount(AnomalyCategory category)
+        {
+            return Interlocked.Read(ref _categoryCounters[(int)category]);
+        }
+
+        /// <summary>
+        /// Gets the total count of all anomalies caught during this session.
+        /// </summary>
+        public static long GetTotalCount()
+        {
+            return Interlocked.Read(ref _totalAnomalies);
+        }
+
+        /// <summary>
+        /// Generates a human-readable telemetry scorecard summary of all captured anomalies.
+        /// </summary>
+        public static string GetSummaryString()
+        {
+            StringBuilder sb = new();
+            sb.AppendLine($"=== Ryubing Gameplay Anomaly Telemetry Summary (Session Uptime: {_uptime.Elapsed}) ===");
+            sb.AppendLine($"Total Anomalies Intercepted: {GetTotalCount()}");
+            foreach (AnomalyCategory cat in Enum.GetValues<AnomalyCategory>())
+            {
+                long cnt = GetCount(cat);
+                if (cnt > 0)
+                {
+                    sb.AppendLine($"  - {cat,-26}: {cnt}");
+                }
+            }
+            return sb.ToString();
+        }
+
+        /// <summary>
+        /// Dumps the current anomaly scorecard to the application notice log.
+        /// </summary>
+        public static void DumpDiagnostics()
+        {
+            Logger.Notice.Print(LogClass.Application, GetSummaryString());
+        }
+
+        /// <summary>
+        /// Resets all counters and ring buffers (used for testing or clean sessions).
+        /// </summary>
+        public static void Reset()
+        {
+            _recentRecords.Clear();
+            for (int i = 0; i < _categoryCounters.Length; i++)
+            {
+                Interlocked.Exchange(ref _categoryCounters[i], 0);
+            }
+            Interlocked.Exchange(ref _totalAnomalies, 0);
+        }
+    }
+}
