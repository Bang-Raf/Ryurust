+                y = q[1];
+                z = q[2];
+                w = q[3];
+            }
+        }
+
+        public bool TryGetOrientationMatrix(Span<float> matrix9)
+        {
+            if (_handle != IntPtr.Zero && _isAvailable && matrix9.Length >= 9)
+            {
+                fixed (float* pM = matrix9)
+                {
+                    _getMatrix(_handle, pM);
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        public void Dispose()
+        {
+            if (_handle != IntPtr.Zero)
+            {
+                _destroy(_handle);
+                _handle = IntPtr.Zero;
+            }
+        }
+    }
+}
