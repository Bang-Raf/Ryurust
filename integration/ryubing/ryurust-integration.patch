         /// <returns>True if the data was changed, false otherwise</returns>
         public bool WriteWithRedundancyCheck(ulong address, ReadOnlySpan<byte> data)
         {
+            if (NativeBufferDiff.IsAvailable && data.Length >= 32 && _cpuMemory.IsMapped(address))
+            {
+                ReadOnlySpan<byte> current = _cpuMemory.GetSpan(address, data.Length);
+                if (NativeBufferDiff.TryIsEqual(data, current, out bool isEqual))
+                {
+                    if (isEqual)
+                    {
+                        return false;
